{
  "name": "@rendering-lab/manual-ssr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.tsx",
    "build:client": "esbuild src/client.tsx --bundle --format=esm --outfile=dist/client.js",
    "build:client:prod": "esbuild src/client.tsx --bundle --format=esm --minify --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/client.prod.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@rendering-lab/ts-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
